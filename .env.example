# Copy to .env, make it private (chmod 600 .env), and fill in locally.
# Never commit this file with real credentials or paste values into a shell or chat.
POSTGRES_PORT=55432
WHATSAPP_WEBHOOK_PORT=18090
WHATSAPP_WEBHOOK_PATH=/whatsapp/webhook
PILATES_MODEL=openai/gpt-6.1-terra
# Reasoning (thinking) effort of the assistant: none, minimal, low, medium, high,
# xhigh, max or ultra. Default: medium. Leave commented to use the default; an
# empty or unknown value stops the start. Applied when the gateway is recreated.
# PILATES_REASONING_EFFORT=medium
# Resume compaction after this many seconds of inactivity per sender (positive
# integer; default 14400 = 4 hours). Leave commented to use the default.
# PILATES_IDLE_COMPACT_SECONDS=14400
# The isolated conversation harness reads CONVERSATION_MODEL and OPENROUTER_API_KEY
# from its process environment, not from this file; see README.
# CONVERSATION_MODEL=openai/gpt-6.1-terra
# Prefix of both Docker volumes (<prefix>_postgres_data, <prefix>_hermes_data).
# Default: the Compose project name. Development can never use the production
# project agent-pilates-prod or its volumes: start:local refuses them.
# PILATES_VOLUME_PREFIX=agent-pilates-dev
# SECRETS_DIR=/absolute/path/to/private/secrets

# Three distinct database passwords, at least 16 characters each.
# start:local generates and preserves the separate db-broker and bridge-token files.
DB_ADMIN_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_AGENT_PASSWORD=
OPENROUTER_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# The manager's WhatsApp number, with the international prefix (+ or 00); common
# separators are accepted and normalized. It is the ONLY personal number in the
# configuration: the home channel derives from it, and every other teacher is
# registered and enabled by the manager in the chat (/anagrafica), in the database.
# Synthetic example; replace locally. WHATSAPP_ALLOWED_USERS, WHATSAPP_HOME_CHANNEL
# and WHATSAPP_TEACHER_LINKS are no longer used: start:local refuses them and
# does not import them. Census in chat does not preregister a Meta test recipient.
# Transferring the manager role or changing the manager's own number is an
# operator procedure, not another key in this file.
PILATES_MANAGER_PHONE=+15555550102
WHATSAPP_PHONE_NUMBER_ID=
