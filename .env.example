# Copy to .env, make it private (chmod 600 .env), and fill in locally.
# Never commit this file with real credentials or paste values into a shell or chat.
POSTGRES_PORT=55432
WHATSAPP_WEBHOOK_PORT=18090
WHATSAPP_WEBHOOK_PATH=/whatsapp/webhook
PILATES_MODEL=openai/gpt-6.1-terra
# The isolated conversation harness reads CONVERSATION_MODEL and OPENROUTER_API_KEY
# from its process environment, not from this file; see README.
# CONVERSATION_MODEL=openai/gpt-6.1-terra
# SECRETS_DIR=/absolute/path/to/private/secrets

# Three distinct database passwords, at least 16 characters each.
# start:local generates and preserves the separate db-broker and bridge-token files.
DB_ADMIN_PASSWORD=
DB_MIGRATOR_PASSWORD=
DB_AGENT_PASSWORD=
OPENROUTER_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# International digits only, comma-separated, no plus sign or spaces.
WHATSAPP_ALLOWED_USERS=
WHATSAPP_PHONE_NUMBER_ID=
