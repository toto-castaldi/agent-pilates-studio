{
  "name": "agent-pilates-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint src test integration scripts prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test --test-isolation=none \"dist/test/**/*.test.js\"",
    "test:local": "npm run build --silent && node --test \"dist/integration/local/**/*.test.js\"",
    "test:db": "npm run build --silent && node --test dist/integration/postgres.test.js",
    "test:hermes": "npm run build --silent && node --test dist/integration/hermes.test.js",
    "test:author": "npm run build --silent && node --test dist/integration/author.test.js dist/integration/home-channel.test.js",
    "test:conversation": "npm run build --silent && node scripts/conversation.mjs",
    "test:compaction": "npm run build --silent && node --test dist/integration/compaction.test.js",
    "test:upgrade": "npm run build --silent && node --test dist/integration/upgrade.test.js",
    "test:pi": "npm run build --silent && node --test dist/integration/pi-settings.test.js dist/integration/pi-backlog.test.js",
    "test:pi-package": "npm run build --silent && node --test dist/integration/pi-package.test.js",
    "start:local": "node scripts/start-local.mjs",
    "test:start": "npm run build --silent && node --test dist/integration/start-local.test.js",
    "db:init-secrets": "node scripts/init-secrets.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "voice:diagnose": "node scripts/voice-diagnose.mjs",
    "voice:setup": "bash scripts/voice-server-setup.sh",
    "build": "npm run clean --silent && tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "ignore": "7.0.5",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
