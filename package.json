{
  "name": "agent-pilates-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "biome lint src test",
    "typecheck": "tsc --noEmit",
    "test": "npm run build --silent && node --test \"dist/test/**/*.test.js\"",
    "build": "npm run clean --silent && tsc"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/node": "24.13.6",
    "typescript": "5.9.3"
  }
}
